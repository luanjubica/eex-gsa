<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="eex_market_data.Dashboard" owl="1">
        <div class="eex-board">
            <header class="eex-header">
                <div><div class="eex-eyebrow">EEX / ENERGY FUTURES</div><h1>Market board</h1><p>Your instruments. One shared market feed.</p></div>
                <button class="btn btn-primary" t-on-click="create"><i class="fa fa-plus me-2"/>New watchlist</button>
            </header>
            <div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/><button class="btn btn-link" t-on-click="load">Retry</button></div>
            <t t-if="state.data">
                <t t-if="state.data.selected">
                    <div class="eex-toolbar">
                        <div><label for="eex-watchlist-select">Watchlist</label><select id="eex-watchlist-select" class="form-select" t-on-change="select"><option t-foreach="state.data.watchlists" t-as="item" t-key="item.id" t-att-value="item.id" t-att-selected="item.id === state.data.selected"><t t-esc="item.name"/></option></select></div>
                        <div class="eex-actions"><button class="btn btn-outline-primary" t-on-click="refresh" t-att-disabled="state.busy"><i class="fa fa-refresh me-2"/>Request refresh</button><button t-if="state.data.can_edit" class="btn btn-outline-secondary" t-on-click="edit">Edit watchlist</button><button class="btn btn-outline-secondary" t-on-click="history">Daily history</button><button class="btn btn-outline-secondary" t-on-click="loadHistory">Load history</button><button class="btn btn-outline-secondary" t-on-click="exportHistory">Export history</button><button class="btn btn-outline-secondary" t-on-click="export">Export board</button></div>
                    </div>
                    <div class="eex-summary">
                        <div><span>Instruments</span><strong t-esc="state.data.rows.length"/></div>
                        <div><span>Collection target</span><strong><t t-if="state.data.refresh_interval"><t t-esc="Math.max(state.data.refresh_interval, state.data.minimum_refresh)"/> sec</t><t t-else="">Manual</t></strong></div>
                        <div><span>Subscription</span><strong t-esc="state.data.timing === 'realtime' ? 'Real-time' : state.data.timing === 'delayed' ? 'Delayed' : 'Timing unverified'"/></div>
                        <div><span>Board checked (UTC)</span><strong t-esc="state.checkedAt || '—'"/></div>
                        <div><span>Feed collection</span><strong t-esc="state.data.collection_progress.label"/></div>
                    </div>
                    <div class="eex-progress-card">
                        <div class="eex-progress-copy">
                            <strong t-esc="state.busy ? 'Checking Odoo now…' : 'Next board cache check in ' + state.secondsUntilCheck + 's'"/>
                            <span>Visible board timer · no direct EEX API call</span>
                        </div>
                        <div class="eex-progress-track" role="progressbar" aria-label="Time until next board cache check" aria-valuemin="0" aria-valuemax="100" t-att-aria-valuenow="state.checkProgress">
                            <span class="eex-progress-bar eex-progress-check" t-att-style="'width: ' + state.checkProgress + '%'"/>
                        </div>
                        <div class="eex-collection-progress">
                            <span><t t-esc="state.data.collection_progress.done"/> / <t t-esc="state.data.collection_progress.total"/> feeds</span>
                            <div class="eex-progress-track" role="progressbar" aria-label="Feed collection progress" aria-valuemin="0" aria-valuemax="100" t-att-aria-valuenow="state.data.collection_progress.percent">
                                <span t-att-class="'eex-progress-bar eex-progress-' + state.data.collection_progress.status" t-att-style="'width: ' + state.data.collection_progress.percent + '%'"/>
                            </div>
                        </div>
                    </div>
                    <div t-if="!state.data.enabled" class="alert alert-warning">Collection is not enabled. An EEX administrator must configure the connection.</div>
                    <div t-if="state.data.pending" class="alert alert-info">A collection refresh has been requested. Prices appear after the background worker completes.</div>
                    <div class="eex-table-wrap" t-if="state.data.rows.length">
                        <table class="table eex-table"><thead><tr><th>Instrument / delivery</th><th>Market / units</th><th t-foreach="state.data.columns" t-as="column" t-key="column.key" class="text-end" t-esc="column.label"/><th>Feed status / fetched (UTC)</th></tr></thead>
                            <tbody><tr t-foreach="state.data.rows" t-as="row" t-key="row.id">
                                <td><strong t-esc="row.name"/><small t-esc="row.long_name"/><small><t t-esc="row.delivery_start"/> — <t t-esc="row.delivery_end"/></small><span t-if="!row.available" class="text-warning">Outside latest catalogue</span></td>
                                <td><strong t-esc="row.market"/><small><t t-esc="row.currency || '—'"/> / <t t-esc="row.price_unit || '—'"/></small><small>Volume: <t t-esc="row.volume_unit || '—'"/></small></td>
                                <td t-foreach="state.data.columns" t-as="column" t-key="column.key" class="text-end eex-number" t-att-title="detail(feed(row, column.key))"><span t-att-class="(['stale', 'error', 'paused'].includes(feed(row, column.key).status) ? 'text-warning ' : '') + (isChanged(row, column.key) ? 'eex-value-changed' : '')" t-esc="value(row, column.key)"/></td>
                                <td class="eex-feed-status"><div class="eex-feed-line" t-foreach="['stat','tob','spr']" t-as="kind" t-key="kind" t-att-title="detail(row.feeds[kind])" t-att-aria-label="detail(row.feeds[kind])"><span t-att-class="'eex-dot eex-' + row.feeds[kind].status"/><strong class="eex-feed-label" t-esc="kind === 'stat' ? 'Stats' : kind === 'tob' ? 'Bid/ask' : 'Settlement'"/><span t-esc="label(row.feeds[kind].status)"/><small class="eex-feed-time" t-esc="shortTime(row.feeds[kind])"/></div></td>
                            </tr></tbody>
                        </table>
                    </div>
                    <div t-else="" class="eex-empty-state"><i class="fa fa-list-alt"/><h2>Choose your futures</h2><p>Add instruments from the catalogue to start following their prices.</p><button t-if="state.data.can_edit" class="btn btn-primary" t-on-click="edit">Select instruments</button></div>
                    <p class="eex-footnote">The board checks Odoo every 15 seconds while this page is visible. EEX collection follows the configured target interval, subject to queue load and EEX limits. Changed values are highlighted for 30 seconds after a board check. “—” means unavailable; settlement prices are for the displayed trading date. History contains sampled observations collected since activation.</p>
                </t>
                <div t-else="" class="eex-empty-state"><i class="fa fa-line-chart"/><h2>A watchlist for your markets</h2><p>Create a personal selection of futures, choose your columns, and set a collection interval.</p><button class="btn btn-primary" t-on-click="create">Create watchlist</button></div>
            </t>
            <div t-elif="!state.error" class="eex-empty-state">Loading market board…</div>
        </div>
    </t>
    <t t-name="eex_market_data.HistoryDashboard" owl="1">
        <div class="eex-board eex-history-board">
            <header class="eex-header">
                <div><div class="eex-eyebrow">EEX / DAILY HISTORY</div><h1><t t-esc="state.data ? state.data.name : 'Daily history'"/></h1><p>Date-by-instrument values from the EEX history feed.</p></div>
                <button class="btn btn-outline-primary" t-on-click="back"><i class="fa fa-arrow-left me-2"/>Market board</button>
            </header>
            <div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/><button class="btn btn-link" t-on-click="load">Retry</button></div>
            <t t-if="state.data">
                <div class="eex-toolbar eex-history-toolbar">
                    <div><label for="eex-history-metric">Displayed value</label><select id="eex-history-metric" class="form-select" t-on-change="selectMetric" t-att-disabled="state.busy"><option t-foreach="state.data.metrics" t-as="metric" t-key="metric.key" t-att-value="metric.key" t-att-selected="metric.key === state.metric"><t t-esc="metric.label"/></option></select></div>
                    <div class="eex-history-meta"><span>Latest <t t-esc="state.data.days"/> trading dates</span><span>Updated <t t-esc="state.data.updated_at ? state.data.updated_at + ' UTC' : '—'"/></span></div>
                    <div class="eex-actions"><button class="btn btn-outline-primary" t-on-click="loadHistory"><i class="fa fa-refresh me-2"/>Load history</button><button class="btn btn-outline-secondary" t-on-click="details">Charts &amp; details</button><button class="btn btn-outline-secondary" t-on-click="exportHistory">Export history</button></div>
                </div>
                <div t-if="state.busy" class="eex-history-loading"><i class="fa fa-spinner fa-spin me-2"/>Loading values…</div>
                <t t-if="state.data.tables.length">
                    <section class="eex-history-section" t-foreach="state.data.tables" t-as="table" t-key="table.id">
                        <div class="eex-history-title"><h2 t-esc="table.name"/><span><t t-esc="state.data.metric_label"/> · <t t-esc="table.rows.length"/> dates</span></div>
                        <div class="eex-table-wrap">
                            <table class="table eex-table eex-history-table">
                                <thead><tr><th class="eex-date-column">Trading date</th><th class="text-end" t-foreach="table.instruments" t-as="instrument" t-key="instrument.id"><strong t-esc="instrument.short_code"/><small t-esc="instrument.maturity"/><small><t t-esc="instrument.currency || '—'"/> / <t t-esc="instrument.unit || '—'"/></small></th></tr></thead>
                                <tbody><tr t-foreach="table.rows" t-as="row" t-key="row.date"><th class="eex-date-column" t-esc="row.date"/><td class="text-end eex-number" t-foreach="row.values" t-as="item" t-key="item_index" t-esc="value(item, state.metric)"/></tr></tbody>
                            </table>
                        </div>
                    </section>
                </t>
                <div t-else="" class="eex-empty-state"><i class="fa fa-table"/><h2>No daily history yet</h2><p>Queue the latest EEX trading days, then return when background collection completes.</p><button class="btn btn-primary" t-on-click="loadHistory">Load history</button></div>
                <p class="eex-footnote">Each market has its own date-by-instrument table. Use the value selector for close, settlement, OHLC, or volume. All update timestamps are UTC.</p>
            </t>
            <div t-elif="!state.error" class="eex-empty-state">Loading daily history…</div>
        </div>
    </t>
</templates>
