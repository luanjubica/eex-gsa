<odoo>
    <record id="view_instrument_search" model="ir.ui.view">
        <field name="name">eex.instrument.search</field><field name="model">eex.instrument</field>
        <field name="arch" type="xml">
            <search>
            <field name="name" filter_domain="['|','|',('name','ilike',self),('long_name','ilike',self),('isin','ilike',self)]"/>
            <field name="short_code"/><field name="commodity"/><field name="area"/><field name="maturity"/><field name="maturity_type"/>
            <filter name="available" string="In latest catalogue" domain="[('available','=',True)]"/>
            <group expand="0" string="Group by"><filter name="market" string="Market" context="{'group_by':'market_id'}"/><filter name="product" string="Product" context="{'group_by':'short_code'}"/><filter name="maturity_type" string="Period" context="{'group_by':'maturity_type'}"/></group>
        </search></field>
    </record>
    <record id="view_instrument_tree" model="ir.ui.view">
        <field name="name">eex.instrument.tree</field><field name="model">eex.instrument</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" decoration-muted="not available"><field name="name"/><field name="long_name" optional="show"/><field name="market_id"/><field name="maturity_type"/><field name="delivery_start"/><field name="delivery_end"/><field name="currency"/><field name="price_unit"/><field name="volume_unit" optional="hide"/><field name="isin" optional="hide"/><field name="available" optional="hide"/></tree></field>
    </record>
    <record id="view_instrument_form" model="ir.ui.view">
        <field name="name">eex.instrument.form</field><field name="model">eex.instrument</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0"><sheet><h1><field name="name"/></h1><group><group><field name="long_name"/><field name="market_id"/><field name="short_code"/><field name="maturity"/><field name="isin"/><field name="maturity_type"/></group><group><field name="currency"/><field name="price_unit"/><field name="volume_unit"/><field name="delivery_start"/><field name="delivery_end"/><field name="expiry_date"/><field name="reference_date"/><field name="available"/></group></group></sheet></form></field>
    </record>
    <record id="action_instruments" model="ir.actions.act_window"><field name="name">Instrument Catalogue</field><field name="res_model">eex.instrument</field><field name="view_mode">tree,form</field><field name="context">{'search_default_available': 1}</field></record>
    <record id="view_snapshot_search" model="ir.ui.view">
        <field name="name">eex.snapshot.search</field><field name="model">eex.snapshot</field>
        <field name="arch" type="xml">
            <search><field name="instrument_id"/><field name="metric"/><filter name="last_price" string="Last price" domain="[('metric','=','last')]"/><filter name="settlement" string="Settlement" domain="[('metric','=','settlement')]"/><group expand="0" string="Group by"><filter name="instrument" string="Instrument" context="{'group_by':'instrument_id'}"/><filter name="metric" string="Metric" context="{'group_by':'metric'}"/><filter name="currency" string="Currency" context="{'group_by':'currency'}"/></group></search></field>
    </record>
    <record id="view_snapshot_graph" model="ir.ui.view">
        <field name="name">eex.snapshot.graph</field><field name="model">eex.snapshot</field>
        <field name="arch" type="xml">
            <graph string="Sampled history (daily averages)" type="line"><field name="captured_at" interval="day"/><field name="instrument_id"/><field name="metric"/><field name="value" type="measure"/></graph></field>
    </record>
    <record id="view_snapshot_tree" model="ir.ui.view">
        <field name="name">eex.snapshot.tree</field><field name="model">eex.snapshot</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0"><field name="instrument_id"/><field name="metric"/><field name="value"/><field name="currency"/><field name="price_unit"/><field name="trade_date"/><field name="source_at"/><field name="captured_at"/></tree></field>
    </record>
    <record id="view_snapshot_pivot" model="ir.ui.view">
        <field name="name">eex.snapshot.pivot</field><field name="model">eex.snapshot</field>
        <field name="arch" type="xml">
            <pivot string="Sampled history (averages)"><field name="instrument_id" type="row"/><field name="metric" type="row"/><field name="captured_at" type="col" interval="day"/><field name="value" type="measure"/></pivot></field>
    </record>
</odoo>
