<odoo>
    <record id="view_book_import_wizard_form" model="ir.ui.view">
        <field name="name">eex.book.import.wizard.form</field>
        <field name="model">eex.book.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import book YAML">
                <group>
                    <field name="file_data" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="name" placeholder="Use first sheet name"/>
                    <field name="refresh_interval"/>
                </group>
                <div class="alert alert-info" role="status">The importer creates one board from all sheets. Fixed symbols select the exact contract; rolling and day/week/weekend symbols select the current matching catalogue contract.</div>
                <footer>
                    <button name="action_import" type="object" string="Import and open board" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_book_import" model="ir.actions.act_window">
        <field name="name">Import book YAML</field>
        <field name="res_model">eex.book.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
