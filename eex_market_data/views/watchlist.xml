<odoo>
    <record id="view_watchlist_tree" model="ir.ui.view">
        <field name="name">eex.watchlist.tree</field><field name="model">eex.watchlist</field>
        <field name="arch" type="xml">
            <tree><field name="name"/><field name="owner_id"/><field name="company_id" groups="base.group_multi_company"/><field name="shared"/><field name="refresh_interval"/><button name="action_dashboard" type="object" string="Open board" icon="fa-table"/></tree></field>
    </record>
    <record id="view_watchlist_form" model="ir.ui.view">
        <field name="name">eex.watchlist.form</field><field name="model">eex.watchlist</field>
        <field name="arch" type="xml">
            <form><header><button name="action_dashboard" type="object" string="Open board" class="oe_highlight"/><button name="action_refresh" type="object" string="Request refresh"/><button name="action_export" type="object" string="Export board"/><button name="action_history" type="object" string="Daily history"/><button name="action_history_refresh" type="object" string="Load history"/><button name="action_history_export" type="object" string="Export history"/></header><sheet>
            <field name="active" invisible="1"/><div class="oe_title"><h1><field name="name" placeholder="e.g. Power — next winter"/></h1></div>
            <group><group><field name="owner_id" readonly="1"/><field name="company_id" groups="base.group_multi_company"/><field name="company_id" invisible="1" groups="!base.group_multi_company"/><field name="shared"/></group><group><field name="refresh_interval"/><field name="last_scheduled"/><field name="refresh_requested"/></group></group>
            <div class="alert alert-info" role="status">Choose instruments from the catalogue. Collection continues in the background while your watchlist is active. Set the interval to 0 for manual collection. The administrator's minimum interval also applies.</div>
            <notebook><page string="Instruments"><field name="instrument_ids" domain="[('company_id','=',company_id),('available','=',True)]" context="{'search_default_available': 1}" options="{'no_create': True}"/></page>
                <page string="Columns"><group><group><field name="show_last"/><field name="show_bid"/><field name="show_ask"/><field name="show_settlement"/></group><group><field name="show_volume"/><field name="show_open"/><field name="show_high"/><field name="show_low"/></group></group></page></notebook>
        </sheet></form></field>
    </record>
    <record id="action_watchlists" model="ir.actions.act_window"><field name="name">Watchlists</field><field name="res_model">eex.watchlist</field><field name="view_mode">tree,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create your first futures watchlist</p><p>Select instruments and choose the columns and refresh interval you need.</p></field></record>
    <record id="action_dashboard" model="ir.actions.client"><field name="name">Market Board</field><field name="tag">eex_market_data.dashboard</field></record>
</odoo>
