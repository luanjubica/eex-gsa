<odoo>
    <record id="module_category_eex" model="ir.module.category">
        <field name="name">EEX Market Data</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_eex_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_eex"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_eex_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_eex"/>
        <field name="implied_ids" eval="[(4, ref('group_eex_user'))]"/>
    </record>
    <record id="watchlist_company_rule" model="ir.rule">
        <field name="name">Watchlists: allowed companies</field>
        <field name="model_id" ref="model_eex_watchlist"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="watchlist_read_rule" model="ir.rule">
        <field name="name">Watchlists: own or shared read</field>
        <field name="model_id" ref="model_eex_watchlist"/>
        <field name="groups" eval="[(4, ref('group_eex_user'))]"/>
        <field name="domain_force">['|', ('owner_id', '=', user.id), ('shared', '=', True)]</field>
        <field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="watchlist_owner_rule" model="ir.rule">
        <field name="name">Watchlists: owner edits</field>
        <field name="model_id" ref="model_eex_watchlist"/>
        <field name="groups" eval="[(4, ref('group_eex_user'))]"/>
        <field name="domain_force">[('owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="watchlist_manager_rule" model="ir.rule">
        <field name="name">Watchlists: administrator management</field>
        <field name="model_id" ref="model_eex_watchlist"/>
        <field name="groups" eval="[(4, ref('group_eex_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="connection_company_rule" model="ir.rule">
        <field name="name">Connections: allowed companies</field><field name="model_id" ref="model_eex_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="market_company_rule" model="ir.rule">
        <field name="name">Markets: allowed companies</field><field name="model_id" ref="model_eex_market"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="instrument_company_rule" model="ir.rule">
        <field name="name">Instruments: allowed companies</field><field name="model_id" ref="model_eex_instrument"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="quote_company_rule" model="ir.rule">
        <field name="name">Quotes: allowed companies</field><field name="model_id" ref="model_eex_quote"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="snapshot_company_rule" model="ir.rule">
        <field name="name">History: allowed companies</field><field name="model_id" ref="model_eex_snapshot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="historical_company_rule" model="ir.rule">
        <field name="name">API history: allowed companies</field><field name="model_id" ref="model_eex_historical"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="job_company_rule" model="ir.rule">
        <field name="name">Jobs: allowed companies</field><field name="model_id" ref="model_eex_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
